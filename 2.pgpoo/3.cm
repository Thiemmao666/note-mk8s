apiVersion: v1
kind: ConfigMap
metadata:
  name: pgpool
  namespace: mcc
data:
  PGPOOL_BACKEND_NODES: "0:postgres-0.postgres-headless.mcc.svc.cluster.local:5432,1:postgres-1.postgres-headless.mcc.svc.cluster.local:5432"
  PGPOOL_BACKEND_APPLICATION_NAMES: "postgres-0,postgres-1"
  PGPOOL_ENABLE_LDAP: "no"
  PGPOOL_AUTO_FAILBACK: "yes"
  PGPOOL_ENABLE_STATEMENT_LOAD_BALANCING: "yes"
  PGPOOL_NUM_INIT_CHILDREN: "90"
  PGPOOL_MAX_POOL: "1"
  PGPOOL_CLIENT_IDLE_LIMIT: "2400" # 45 mins
  JAVA_OPTS: "-Duser.timezone=Asia/Ho_Chi_Minh"
