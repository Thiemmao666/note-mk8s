.. Install Alloy

  - Chart: alloy-1.0.3.tgz

  - Values file: values-alloy-srv.yaml

values-alloy-srv.yml


alloy:
  mounts:
    varlog: true
  configMap:
    content: |
      logging {
        level  = "info"
        format = "logfmt"
      }

      // Discovers all kubernetes pods.
      // Relies on serviceAccountName=grafana-alloy in the pod spec for permissions.
      discovery.kubernetes "pods" {
        role = "pod"
      }

      loki.source.kubernetes "pods" {
        targets    = discovery.kubernetes.pods.targets
        forward_to = [loki.write.endpoint.receiver]
      }

      loki.write "endpoint" {
        endpoint {
            url = "http://loki-gateway.monitoring.svc.cluster.local:80/loki/api/v1/push"
            tenant_id = "local"
        }
      }

image:
  # -- Grafana Alloy image registry (defaults to docker.io)
  registry: "docker-remote.bart.sec.samsung.net"

# Options for the extra controller used for config reloading.
configReloader:
  image:
    # -- Config reloader image registry (defaults to docker.io)
    registry: "quay-docker-remote.bart.sec.samsung.net"


Install Alloy locally using Helm


# Install Alloy
helm install --namespace monitoring alloy ./alloy-1.0.3.tgz -f values-alloy-srv.yaml

# Check deployed chart
helm ls -n monitoring

# Forward port to access Alloy UI
kubectl --namespace monitoring port-forward --address 0.0.0.0 ${replace-this-with-pod-name} 12345


 - Access UI to check if Alloy works: http://localhost:12345



